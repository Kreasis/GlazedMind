# Runtime. Demo mode accelerates priority follow-ups from days to minutes.
DEMO_MODE=true

# Optional OpenAI fallback (Ollama is preferred when configured)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Ollama (preferred when configured; OpenAI remains optional)
OLLAMA_BASE_URL=http://172.16.99.107:4000
OLLAMA_API_KEY=
OLLAMA_ACK_MODEL=qwen3.5:4b
OLLAMA_ACK_TIMEOUT_SECONDS=20
AUTO_ACK_ENABLED=true
AUTO_ACK_INTERVAL_SECONDS=30
AUTO_FOLLOWUP_ENABLED=true
AUTO_FOLLOWUP_INTERVAL_SECONDS=10
# Allowed values: days, or minutes only when DEMO_MODE=true.
AUTO_FOLLOWUP_TIME_UNIT=minutes
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
DATABASE_URL=postgresql+psycopg://glazed:glazed@postgres:5432/glazed_mind

# Frontend (used by Docker; use localhost for a local non-Docker backend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Monday.com integration
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=18425869337
MONDAY_API_URL=https://api.monday.com/v2
